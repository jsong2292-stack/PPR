engine-strict=true
strict-peer-dependencies=false
auto-install-peers=true
resolution-mode=highest
package-manager-strict=true

# pnpm 10+ 默认不执行依赖的构建脚本。本项目不需要依赖编译原生扩展：
# - sharp 仅用于 next/image 的运行时优化，本项目未开启图片优化
# - esbuild 只是 tsx 的传递依赖，tsx 自带可用二进制
# 明确关闭校验，避免 pnpm install 因「Ignored build scripts」报错退出。
dangerously-allow-all-builds=false
verify-deps-before-run=false
