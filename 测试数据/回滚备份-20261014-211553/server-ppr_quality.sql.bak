/*!40000 ALTER TABLE `ppr_analysis_run` DISABLE KEYS */;
INSERT INTO `ppr_analysis_run` VALUES (1,'AN-20261013014016-127Q',1,'completed','QE-20261010-001 在批次 12121D0032 触发“待复核趋势”。系统已关联同批次产品检验与同期设备数据；以下结论均为待工程师验证的排查线索。','{\"alert\": {\"id\": 3, \"remark\": \"连续趋势触发\", \"status\": \"open\", \"batch_id\": 1, \"batch_no\": \"12121D0032\", \"event_no\": \"QE-20261010-001\", \"record_no\": \"IR-20261010-003\", \"rule_code\": \"R4\", \"rule_name\": \"待复核趋势\", \"sample_no\": \"S-003\", \"spec_name\": \"PPR S2.5 25×4.2 瓷芯管\", \"created_at\": \"2026-10-13T01:36:53.000Z\", \"ovality_mm\": \"0.250\", \"risk_level\": \"medium\", \"updated_at\": \"2026-10-13T01:36:53.000Z\", \"data_source\": \"QMS\", \"detected_at\": \"2026-10-10T09:38:00.000Z\", \"metric_code\": \"min_wall_thickness\", \"inspect_time\": \"2026-10-10T09:37:00.000Z\", \"quality_flag\": \"medium\", \"wall_lower_mm\": \"4.200\", \"wall_upper_mm\": \"4.800\", \"measurement_id\": 3, \"observed_value\": \"4.2600\", \"outer_lower_mm\": \"25.000\", \"outer_upper_mm\": \"25.500\", \"threshold_text\": \"连续3个可比较点下降，规则参数待现场验证\", \"ovality_upper_mm\": \"0.350\", \"production_group\": \"甲班\", \"outer_diameter_mm\": \"25.250\", \"max_outer_diameter_mm\": \"25.350\", \"max_wall_thickness_mm\": \"4.390\", \"min_outer_diameter_mm\": \"25.100\", \"min_wall_thickness_mm\": \"4.260\"}, \"readings\": [{\"id\": 3, \"remark\": \"牵引速度上升\", \"batch_id\": 1, \"record_no\": \"ER-20261010-1000\", \"created_at\": \"2026-10-13T01:36:53.000Z\", \"updated_at\": \"2026-10-13T01:36:53.000Z\", \"data_source\": \"SCADA\", \"collect_time\": \"2026-10-10T10:00:00.000Z\", \"equipment_id\": 1, \"pressure_mpa\": \"12.200\", \"temperature_c\": \"206.00\", \"equipment_name\": \"1号挤出机\", \"haul_off_speed_mpm\": \"8.450\"}, {\"id\": 2, \"remark\": \"压力轻微下降\", \"batch_id\": 1, \"record_no\": \"ER-20261010-0900\", \"created_at\": \"2026-10-13T01:36:53.000Z\", \"updated_at\": \"2026-10-13T01:36:53.000Z\", \"data_source\": \"SCADA\", \"collect_time\": \"2026-10-10T09:00:00.000Z\", \"equipment_id\": 1, \"pressure_mpa\"