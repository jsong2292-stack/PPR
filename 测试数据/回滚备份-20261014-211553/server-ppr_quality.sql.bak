UNLOCK TABLES;

--
-- Table structure for table `ppr_analysis_conclusion`
--

DROP TABLE IF EXISTS `ppr_analysis_conclusion`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `ppr_analysis_conclusion` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT '主键，自增编号',
  `analysis_id` bigint unsigned NOT NULL COMMENT '所属分析任务ID',
  `sort_no` int NOT NULL DEFAULT '0' COMMENT '同一分析内展示顺序',
  `category` varchar(100) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '结论类别，如限值对照、趋势观察、相关因素变化',
  `hypothesis` text COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '待验证结论或假设内容',
  `evidence` text COLLATE utf8mb4_unicode_ci COMMENT '支持证据说明',
  `missing_evidence` text COLLATE utf8mb4_unicode_ci COMMENT '缺失证据说明',
  `validation_action` text COLLATE utf8mb4_unicode_ci COMMENT '建议验证动作',
  `confidence` decimal(5,4) DEFAULT NULL COMMENT '证据完备度置信分，0到1，不代表根因概率',
  `evidence_source_ids` json DEFAULT NULL COMMENT '本结论引用的产品、设备或事件业务编号',
  `generated_by_model` varchar(100) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '生成本结论的模型名称，规则模式为空',
  `engineer_modified` tinyint(1) NOT NULL DEFAULT '0' COMMENT '工程师是否修改或补充过本结论',
  `engineer_decision` enum('pending','confirmed','rejected') COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'pending' COMMENT '工程师判定：待处理、已确认、已驳回',
  `engineer_comment` text COLLATE utf8mb4_unicode_ci COMMENT '工程师意见',
  `actual_finding` text COLLATE utf8mb4_unicode_ci COMMENT '现场验证实际发现',
  `updated_by` varchar(100) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '最近更新人',
  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `updated_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
  PRIMARY KEY (`id`),
  KEY `idx_ppr_conclusion_analysis` (`analysis_id`,`sort_no`),
  CONSTRAINT `fk_ppr_conclusion_analysis` FOREIGN KEY (`analysis_id`) REFERENCES `ppr_analysis_run` (`id`) ON DELETE CASCADE
) ENGINE=InnoDB AUTO_INCREMENT=87 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='PPR异常诊断结论与工程师验证';
/*!40101 SET character_set_client = @saved_cs_client */;

--
-- Dumping data for table `ppr_analysis_conclusion`
--

LOCK TABLES `ppr_analysis_conclusion` WRITE;
/*!40000 ALTER TABLE `ppr_analysis_conclusion` DISABLE KEYS */;
INSERT INTO `ppr_analysis_conclusion` VALUES (1,1,1,'触发规则与限值对照','待复核趋势：当前观测值 4.2600 mm，连续3个可比较点下降，规则参数待现场验证。','记录 IR-20261010-003 / 样管 S-003 / Sat Oct 10 2026 17:37:00 GMT+0800 (China Standard Time)，来源 QMS。','正式标准条款、量具状态、原始检验单与测量方法仍需现场确认。','复核样管身份、原始测量值、适用规格和测量方法；演示限值不直接等同合格判定。',NULL,NULL,NULL,0,'confirmed','E2E验证通过','现场复核记录完整，确认作为报告输入','E2E测试','2026-10-13 01:40:16','2026-10-13 01:40:26'),(2,1,2,'变化趋势观察','最近 3 个同批次可比较点由 4.320 变化至 4.260 mm，净变化 -0.060 mm。','Sat Oct 10 2026 16:20:00 GMT+0800 (China Standard Time): 4.320 mm；Sat Oct 10 2026 17:05:00 GMT+0800 (China Standard Time): 4.290 mm；Sat Oct 10 2026 17:37:00 GMT+0800 (China Standard Time): 4.260 mm','停机、换规格、生产连续性和检测延迟信息未完全确认。','补齐连续抽检点并核对运行日志，区分连续趋势与离散波动。',NULL,NULL,NULL,0,'confirmed','E2E验证通过','现场复核记录完整，确认作为报告输入','E2E测试','2026-10-13 01:40:16','2026-10-13 01:40:26'),(3,1,3,'同期设备因素','同批次同期关联到 3 条设备采集数据，可优先核查温度、压力与牵引速度是否在异常前后发生变化。','Sat Oct 10 2026 18:00:00 GMT+0800 (China Standard Time) 1号挤出机: 温度206.00℃ / 压力12.200MPa / 牵引8.450m/min；Sat Oct 10 2026 17:00:00 GMT+0800 (China Standard Time) 1号挤出机: 温度205.50℃ / 压力12.400MPa / 牵引8.300m/min；Sat Oct 10 2026 16:00:00 GMT+0800 (China Standard Time) 1号挤出机: 温度205.00℃ / 压力12.600MPa / 牵引8.200m/min','设备设定值、调机记录、报警和运行状态尚未接入。','由设备工程师核对异常时段设定值、反馈值、调机与报警记录；同期变化不等同因果。',NULL,NULL,NULL,0,'confirmed','E2E验证通过','现场复核记录完整，确认作为报告输入','E2E测试','2026-10-13 01:40:16','2026-10-13 01:40:26'),(25,9,1,'观察事实','本批最薄壁厚存在向规格下限方向的下行趋势，可能持续接近或突破4.200mm下限，需验证是否为趋势性漂移。','本批S-001→S-004最薄壁厚依次为4.320/4.290/4.260/4.270mm，S-002起连续3点进入接近带（距下限≤0.090mm），触发R5规则；4点均未低于下限4.200mm。','触发点之后的后续检验点、同批其他样本（壁厚分布多点）及延续时长数据','调取该批10:15之后的检验记录并加严抽样频次，确认该下行是持续漂移还是短期波动；同时测量同一截面多点壁厚评估整体壁厚分布。',0.8000,'[\"IR-20261010-001\", \"IR-20261010-002\", \"IR-20261010-003\", \"IR-20261010-004\", \"QE-20261010-004WT\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-13 07:49:43','2026-10-13 07:49:43'),(26,9,2,'待验证假设','同期牵引速度上升与挤出压力下降可能共同导致壁厚减薄（牵引提速使单位长度挤出量摊薄），但无法由同期数据证明因果。','EQ-EX-01在08:00→10:00压力12.600→12.400→12.200MPa单调下降，牵引速度8.200→8.300→8.450m/min单调上升，温度205.0→206.0℃；同期最薄壁厚由4.320降至4.270mm。','挤出量/螺杆转速、熔体泵输出、在线测厚数据，以及设备参数调整记录（是否为人为设定变更）','核对10:00前后牵引速度与挤出量设定值变更记录，做牵引速度-壁厚相关性验证（如单因素回退试验或历史参数-壁厚配对分析），确认因果关系。',0.5500,'[\"ER-20261010-0800\", \"ER-20261010-0900\", \"ER-20261010-1000\", \"IR-20261010-001\", \"IR-20261010-004\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-13 07:49:43','2026-10-13 07:49:43'),(27,9,3,'待验证假设','模具偏心或原料波动造成壁厚分布不均，使最薄点下行（规格口径提示影响因素含挤出量、牵引速度、模具偏心、原料波动），本批ovality略有增大可能支持偏心/分布不均方向。','本批ovality由S-001的0.190mm升至S-004的0.240mm，同批仍有上升；缺陷表现为最薄壁厚下行而最大壁厚同步由4.430降至4.420mm，即内外壁同步减薄而非单纯分布恶化。','同一截面多点壁厚（周向分布）数据、模具偏心检测报告、原料批次与熔指记录','对S-003/S-004留存样做周向多点壁厚测量并检视模具偏心，核查该时间段投用原料批次是否与前一正常批次一致。',0.4000,'[\"IR-20261010-001\", \"IR-20261010-004\", \"IR-20261010-002\", \"IR-20261010-003\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-13 07:49:43','2026-10-13 07:49:43'),(28,9,4,'参考对照','本批壁厚水平低于同规格其他批次，提示存在批次级（设备或工艺条件）差异，而非产品规格本身的正常波动范围。','参考批次12121D0033（乙班）最薄壁厚4.340–4.350mm、12121D0034（甲班）为4.360–4.390mm，均高于本批触发时的4.260–4.290mm；参考批次quality_flag均为normal。','两参考批次的设备参数（牵引速度、压力、温度）与模具配置，是否与本批同机同模生产','对比参考批次与本批的设备窗口参数与模具/原料信息，确定差异来源后作为工艺调节基线参考（注意跨批次差异不等同正式控制限）。',0.5000,'[\"IR-20261012-001\", \"IR-20261012-002\", \"IR-20261012-004\", \"IR-20261012-008\", \"IR-20261011-001\", \"IR-20261011-003\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-13 07:49:43','2026-10-13 07:49:43'),(29,9,5,'缺失证据','当前证据不足以判定该趋势会否导致超限或确定为系统性问题，需补充过程能力与设备点检信息。','工具返回数据仅覆盖本批4个检验点与3条SCADA记录（08:00–10:00），无更早基线、无后续数据、无机台停机/保养/更换记录，无法评估趋势外推与设备健康状态。','异常前后更长时间序列（≥24h）、机台点检与停机保养记录、在线测厚连续数据、同机其他产品对比','扩展调取该机台24小时以上趋势数据与设备点检记录，建立该规格最薄壁厚的过程能力（Cp/Cpk）基线，再判断是否升级为工程处置。',0.3500,'[\"QE-20261010-004WT\", \"ER-20261010-0800\", \"ER-20261010-0900\", \"ER-20261010-1000\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-13 07:49:43','2026-10-13 07:49:43'),(40,12,1,'观察事实','本批次最小壁厚在异常时段呈持续下降并稳定贴近下限的走势，非单点跳变。','本批 4 点序列：S-001 4.320（08:20，基线点）→ S-002 4.290（09:05）→ S-003 4.260（09:37）→ S-004 4.270（10:15）；规则 R5 判定 S-002~S-004 连续 3 点进入接近带（距下限 ≤0.090 mm，区间宽度 0.600 mm 的 15%），触发值 4.270 mm。','缺少该批次 S-004 之后的后续检验点，无法判断趋势是继续下降、企稳还是回升。','立即追加取样（建议连续 3–5 点，间隔不大于 1 小时）并加测同截面多点壁厚，确认趋势是否收敛。',0.9000,'[\"ALERT:QE-20261010-004WT\", \"BATCH:IR-20261010-001~004\", \"METRIC:min_wall_thickness\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-13 08:57:44','2026-10-13 08:57:44'),(41,12,2,'观察事实','同期采集数据（牵引速度上升、压力下降）与壁厚下降在时间上同向出现，仅构成相关线索。','EQ-EX-01 采集：08:00 牵引 8.200 m/min、压力 12.600 MPa、温度 205.00 ℃（稳定运行）；09:00 牵引 8.300、压力 12.400（压力轻微下降）；10:00 牵引 8.450、压力 12.200（牵引速度上升）。检验点壁厚同期由 4.320 降至 4.270 mm。','设备窗口仅 3 个整点采集点（08:00/09:00/10:00），无逐分钟趋势、无挤出量/螺杆转速/熔体泵参数，也无模具偏心与壁厚方位数据，无法排除其他因素。','调取 08:00–11:00 逐分钟挤出量与牵引速度曲线，核对牵引速度调整记录与操作日志；结合逐点壁厚做时序对齐比较。',0.4500,'[\"EQUIP:ER-20261010-0800/0900/1000\", \"BATCH:IR-20261010-001~004\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-13 08:57:44','2026-10-13 08:57:44'),(42,12,3,'待验证假设','牵引速度上升导致挤出物在定径段被拉薄，是本次最小壁厚趋近下限的可能原因之一（未确认）。','指标口径提示 min_wall_thickness 受挤出量、牵引速度、模具偏心、原料波动影响；同期牵引速度由 8.200 升至 8.450 m/min（+0.250），压力由 12.600 降至 12.200 MPa（−0.400），方向与壁厚下降一致。','缺少牵引速度与壁厚的定量关系（线速—壁厚敏感度）、挤出量实测值与历史同参数对照，相关性到因果性不成立。','在相同配方条件下做牵引速度单因子阶梯试验或小批验证，对比壁厚响应；同时核查挤出量是否同步变化。',0.3500,'[\"METRIC:min_wall_thickness\", \"EQUIP:ER-20261010-0800/0900/1000\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-13 08:57:44','2026-10-13 08:57:44'),(43,12,4,'待验证假设','本批次壁厚水平整体低于同规格近期正常批次，可能指示本批工艺窗口偏移（未确认）。','参考批次：12121D0033（乙班，10-11）最小壁厚 4.340/4.350 mm；12121D0034（甲班，10-12）最小壁厚 4.360–4.390 mm，波动仅 0.030 mm 且 ovality 稳定 0.210–0.230；本批 S-002~S-004 为 4.260–4.290 mm，明显低于上述参考值。','参考批次为跨批次对照，不等同正式控制限；缺少 12121D0032 前段检验点与同班次历史批次完整序列。','补充调取 12121D0032 全批次及同规格前 5 个批次的检验序列，做批间均值/极差比较，必要时触发控制图复核。',0.5000,'[\"REF:IR-20261011-001/003\", \"REF:IR-20261012-001~008\", \"BATCH:IR-20261010-001~004\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-13 08:57:44','2026-10-13 08:57:44'),(44,12,5,'缺失证据','无法就模具偏心、原料波动或牵引/定径异常给出可验证的判定，需补充数据后再评估。','工具返回信息中不含模具偏心量、原料批次与熔指、定径套真空/水温、操作调整记录；ovality 本批 0.190→0.240 mm（上限 0.350 mm）略有上升，但不足以单独说明偏心。','模具偏心检测记录、原料批号与来料检验、定径与真空系统参数、异常时刻操作/换料/换模记录均缺失。','按上述清单补齐工艺与物料记录，并在确认后开展剖切/偏心测量，先排除或确认偏心与原料因素。',0.2500,'[\"ALERT:QE-20261010-004WT\", \"METRIC:min_wall_thickness\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-13 08:57:44','2026-10-13 08:57:44'),(45,12,6,'风险判定','当前状态为未越限的趋势性预警，但余量收窄，需按不合格风险对待并加密管控。','规格限值 4.200–4.800 mm（来源 ppr_product_spec）；本批最小观测 4.260 mm，距下限余量最小 0.060 mm；风险等级来源于告警记录 risk_level=medium，状态 analyzing。','缺少该批次已生产长度/卷重与抽样覆盖比例，无法量化受影响产品范围。','对 S-002 之后产出进行隔离与全项复检（壁厚、外径、ovality），在工程师确认前不作出最终根因和放行结论。',0.7500,'[\"ALERT:QE-20261010-004WT\", \"METRIC:min_wall_thickness\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-13 08:57:44','2026-10-13 08:57:44'),(46,13,1,'观察事实（趋势）','本批次最薄壁厚存在自 08:20 起的单调下行趋势（4.320→4.290→4.260→4.270），10:15 出现回升 0.010 mm，趋势是否已稳定需后续点确认。','批次 12121D0032 检验序列 min_wall_thickness = 4.320/4.290/4.260/4.270 mm，外径基本稳定在 25.23–25.26 mm，椭圆度 0.19–0.25 mm。','10:15 之后的后续检验点缺失，无法判断是否止跌或继续下行。','调取该批次 10:15 以后及相邻班次的最薄壁厚检验数据，确认趋势斜率与是否触底。',0.8500,'[\"IR-20261010-001\", \"IR-20261010-002\", \"IR-20261010-003\", \"IR-20261010-004\", \"get_metric_definition\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-13 09:01:41','2026-10-13 09:01:41'),(47,13,2,'待验证假设（工艺-牵引速度）','同期牵引速度由 8.200 升至 8.450 m/min、机头压力由 12.600 降至 12.200 MPa，可能与壁厚下行相关（牵引加速拉薄壁厚）；同期变化不能证明因果。','EQ-EX-01 三条采集记录：08:00 8.200/12.600；09:00 8.300/12.400（压力轻微下降）；10:00 8.450/12.200（牵引速度上升）；温度 205.0→206.0 ℃ 基本稳定。','缺少挤出量/螺杆转速、熔体泵反馈、牵引与挤出速度比设定值，以及设备参数变更记录，无法建立定量因果。','核查异常时段螺杆转速与挤出量、牵引速度设定与实际值、速度比；由工艺工程师评估速度比偏移对最薄壁厚的敏感度。',0.5000,'[\"ER-20261010-0800\", \"ER-20261010-0900\", \"ER-20261010-1000\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-13 09:01:41','2026-10-13 09:01:41'),(48,13,3,'待验证假设（模具偏心/壁厚分布）','最薄点下行可能源于模具偏心或壁厚分布变化，而非整体壁厚减小；本批次 max-min 壁厚差约 0.13–0.16 mm，椭圆度 0.19–0.25 mm 未出现同步恶化，该假设证据不足。','同批次 max_wall_thickness 4.430/4.410/4.390/4.420 mm，最薄点与最厚点同步小幅下降；椭圆度 0.190→0.240 mm，仍远低于规格上限 0.350 mm。指标定义指出“仅最薄点不能代表整体壁厚分布”。','缺少最薄点周向位置、多点壁厚分布测量与模具/芯棒状态记录。','补充同截面多点壁厚测量并记录最薄点周向方位，检查定径/芯棒与口模对中状态。',0.3500,'[\"IR-20261010-004\", \"get_metric_definition\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-13 09:01:41','2026-10-13 09:01:41'),(49,13,4,'参考对照','同规格后续批次（12121D0033 乙班、12121D0034 甲班）最薄壁厚稳定在 4.34–4.39 mm，明显高于本批次 4.26–4.32 mm，提示本批次存在批次性偏低可能，但跨批次差异不能作为正式控制限。','参考记录 min_wall_thickness 4.340–4.390 mm（12121D0033/12121D0034），外径 25.21–25.24 mm，quality_flag 均为 normal。','缺少本批次使用的原料批次/配方、模具编号与开机时间等可比条件，无法排除原料或换模差异。','核对本批次与参考批次的原料批号、配方、模具编号及开机/换模时间，做同条件对比。',0.6000,'[\"IR-20261011-001\", \"IR-20261011-003\", \"IR-20261012-001\", \"IR-20261012-005\", \"IR-20261012-008\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-13 09:01:41','2026-10-13 09:01:41'),(50,13,5,'判定边界说明','当前 min_wall_thickness 4.270 mm 高于规格下限 4.200 mm（余量 0.070 mm），未构成不合格判定；触发依据仅为“连续3点进入接近带”的预警规则。','产品规格限值 4.200–4.800 mm（limit_source：产品规格 ppr_product_spec 标准限值）；触发记录为“4.290/4.260/4.270，距下限 ≤0.090 mm”，检验备注“连续3点趋近下限，未越限”。','缺少已确认的过程能力指数与内控限值文件，无法评估距内控线的实际余量。','由质量工程师确认该规格内控限值/预警带设置，并评估按现有趋势的越限时间窗口。',0.9000,'[\"get_alert_context\", \"get_metric_definition\", \"IR-20261010-004\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-13 09:01:41','2026-10-13 09:01:41'),(51,13,6,'数据缺口','现有证据不足以确定根因：牵引速度/压力的同期变化仅构成线索，缺少原料波动与模具状态数据，无法排除原料或模具主导。','指标定义列出的影响因素为挤出量、牵引速度、模具偏心、原料波动，本次取证仅覆盖检验序列与挤出机单点窗口数据。','原料批次与熔指/水分数据、模具偏心与对中记录、挤出量与熔体泵数据、设备维保与参数变更记录。','按上述清单补齐证据后组织工艺、设备、质量三方复核，再判定根因与是否需要调整参数。',0.7500,'[\"get_metric_definition\", \"get_equipment_window\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-13 09:01:41','2026-10-13 09:01:41'),(52,14,1,'趋势特征','本批次最薄壁厚呈单向漂移（基线 4.320 → 4.260 mm，累计下降约 0.060 mm），而非随机波动，需确认是否仍在持续下行。','IR-20261010-001 至 004 的 min_wall_thickness 依次为 4.320/4.290/4.260/4.270 mm，前三点单调下降，第4点小幅回升；remark 亦记录「壁厚呈下降趋势」「壁厚趋近下限」「连续3点趋近下限，未越限」。','缺少规格中心值与过程能力/控制限（仅有规格限 4.200–4.800 mm）；样本量仅4点，无法判定是随机还是系统漂移；无同批次更多测点与出厂长度分布。','按加严频次继续取5–10点连续测量，用同一规格限做趋势图；若仍处接近带或继续下行，升级为待处置批。',0.7000,'[\"IR-20261010-001\", \"IR-20261010-002\", \"IR-20261010-003\", \"IR-20261010-004\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-13 09:02:19','2026-10-13 09:02:19'),(53,14,2,'设备共变线索','壁厚下行与1号挤出机同期牵引速度上升、机筒压力下降存在时间共变，需验证是否为工艺参数（牵引/挤出匹配）变化导致壁厚减薄。','EQ-EX-01（1号挤出机）SCADA：08:00 压力12.600 MPa/牵引8.200 mpm；09:00 压力12.400 MPa/牵引8.300 mpm（备注压力轻微下降）；10:00 压力12.200 MPa/牵引8.450 mpm（备注牵引速度上升）；与检验序列同时间窗。','SCADA样本仅每小时1点、共3条，无挤出量/螺杆转速/熔体压力实时曲线，无法建立定量相关；未确认是否有任何设定值调整记录或变更单。','调取09:00–11:00的挤出机原始趋势曲线与参数调整/报警记录，核对牵引速度设定值与实际值差异及压力下降幅度是否超出常规波动。',0.4500,'[\"ER-20261010-0800\", \"ER-20261010-0900\", \"ER-20261010-1000\", \"IR-20261010-004\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-13 09:02:19','2026-10-13 09:02:19'),(54,14,3,'批次对照','本批次壁厚水平整体低于后续同规格正常批次，提示可能存在批次级工艺/原料差异，而非单点测量异常。','本批次四点为4.320/4.290/4.260/4.270 mm；参考批次 12121D0033（乙班）为 4.340/4.350 mm、12121D0034（甲班）8点全部在 4.360–4.390 mm 且 quality_flag=normal。','参考批次为异常之后的10-11、10-12批次，非同期平行对照；跨批次差异不等同正式控制限，未见原料批号、模具/机头更换记录、环境条件。','核对本批次与参考批次的原料批号、模具/机头状态与工艺参数设定记录，判断差异来源；如需控制限须另行做过程能力研究。',0.5000,'[\"IR-20261010-001\", \"IR-20261010-004\", \"IR-20261012-001\", \"IR-20261011-001\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-13 09:02:19','2026-10-13 09:02:19'),(55,14,4,'偏心/壁厚分布','最薄点下行可能与壁厚分布不均（模具偏心）有关，需结合同点最大壁厚与不圆度评估。','本批次 IR-004：min 4.270 / max 4.420 mm，壁厚极差0.150 mm；ovality 0.240 mm（上限 0.350 mm），不圆度相对稳定但略高于前三点0.190/0.220/0.250中的基线值。','无沿圆周多点壁厚测量、无偏心度直读值、无模具/定径套维护记录；min_wall_thickness 定义即限定「仅最薄点不能代表整体壁厚分布」（指标定义）。','对留样做圆周多点（≥8方位）壁厚与偏心度测量，并核查定径套/机头同心度与最近一次维护时间。',0.3500,'[\"IR-20261010-004\", \"IR-20261010-001\", \"metric:min_wall_thickness\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-13 09:02:19','2026-10-13 09:02:19'),(56,14,5,'规格合规边界','当前所有已测点均在正式规格限内，属“趋近未越限”，不构成越限不合格，但余量已明显收窄。','预警上下文与指标定义均给出规格限 4.200–4.800 mm（limit_source：产品规格 ppr_product_spec）；最薄 4.260 mm（IR-003）距下限余量0.060 mm，最厚 4.430 mm 距上限余量0.370 mm；外径 25.120–25.360 mm 位于 25.000–25.500 mm 内。','接近带阈值（区间宽度15%，距下限≤0.090 mm）来自触发规则文本，非产品合格判定标准；缺少连续越限或趋势超出控制限的判定依据。','按规格限继续判定放行/待处理，但以加严频次监控；在工程师确认前不将接近带视为不合格或风险放行依据。',0.7500,'[\"alert:QE-20261010-004WT\", \"metric:min_wall_thickness\", \"IR-20261010-003\", \"IR-20261010-001\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-13 09:02:19','2026-10-13 09:02:19'),(62,16,1,'观察事实-趋势','本批次 min_wall_thickness 存在连续下行趋势，尚未越限但逼近下限。','批次内4点序列：4.320(08:20,基线)—4.290(09:05)—4.260(09:37)—4.270(10:15) mm；后三点均落在 4.200 mm 下限上方 0.090 mm 接近带内，触发 R5；质量标记由 normal 变为 medium。','缺少 4.270 mm 之后的后续检验点，无法判定是否继续下降、止跌或回升。','调取该批次 10:15 之后的检验序列并加严抽样频次，确认趋势是否延续或已收敛。',0.8500,'[\"alert:QE-20261010-004WT\", \"batch:IR-20261010-001..004\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-13 09:05:24','2026-10-13 09:05:24'),(63,16,2,'观察事实-分布形态','壁厚下降可能同时表现为整体壁厚减薄（min 与 max 同步下移），而非单纯壁厚均匀性变化。','同点成对数据：S-001 max 4.430、S-002 4.410、S-003 4.390、S-004 4.420 mm；min 与 max 大致同向下移，差值约 0.11–0.13 mm；ovalty 0.190–0.250 mm，远低于规格上限 0.350 mm。','缺少同一截面全周多点壁厚分布数据；指标定义已提示「仅最薄点不能代表整体壁厚分布」。','对该批次样管补做截面全周壁厚测量，比较平均值与最薄点变化，区分整体减薄与偏心率变化。',0.6000,'[\"batch:IR-20261010-001..004\", \"metric:min_wall_thickness\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-13 09:05:24','2026-10-13 09:05:24'),(64,16,3,'待验证假设-设备/工艺','同时段牵引速度上升与挤出压力下降可能与壁厚减薄相关（相关线索，非因果）。','SCADA（EQ-EX-01）08:00→10:00：pressure 12.60→12.40→12.20 MPa，haul_off_speed 8.20→8.30→8.45 m/min，temperature 205.0→206.0 ℃；与检验点 window 在时间上重叠。','设备窗口仅有3个采集点（4小时窗口内采样密度不足），无异常前长时间基线、无螺杆转速/喂料量/熔体泵参数、无挤出量实测；无法排除环境与原料扰动。','由工艺工程师核对同批次 08:00–11:00 完整 SCADA 曲线（螺杆转速、喂料量、熔体温度与压力、牵引速度设定值变更记录），确认是否存在参数调整或漂移。',0.3500,'[\"equip:ER-20261010-0800/0900/1000\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-13 09:05:24','2026-10-13 09:05:24'),(65,16,4,'待验证假设-跨批次对照','本批次 min_wall 水平低于同规格其他批次，提示为批次性/阶段性工艺偏移而非随机波动。','参考批次 12121D0034（甲班，10-12）min_wall 4.360–4.390 mm；12121D0033（乙班，10-11）4.340–4.350 mm，均高于本批次 4.260–4.290 mm；外径均处于 25.000–25.500 mm 规格内。','参考批次与异常批次不同日期、不同班次，跨批次差异不等于正式控制限；缺少同批次/同机台历史分布与原料批次信息。','拉取该机台近1–2周同规格 min_wall 分布与班次对比，建立过程基线与控制图，判断本次偏移幅度是否超出正常波动。',0.5000,'[\"ref:IR-20261011-001/003\", \"ref:IR-20261012-001..008\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-13 09:05:24','2026-10-13 09:05:24'),(66,16,5,'待验证假设-原料/模具','原料波动或模具偏心（指标定义列出的影响因素）为本批次壁厚偏薄的候选原因之一。','指标定义将 min_wall_thickness 的影响因素列为挤出量、牵引速度、模具偏心、原料波动；本批次外径正常（25.230–25.260 mm）而壁厚偏低，符合「外径不变、壁厚分配变化」的形态特征。','无原料批次/牌号与来料检验数据，无模具间隙、定径套与检修记录，无偏心度实测，无法区分原料与模具贡献。','核对本批次原料批号与来料检验记录，并调阅模具/定径套近期检修与更换记录，必要时进行偏心度测试。',0.2500,'[\"metric:min_wall_thickness\", \"batch:IR-20261010-004\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-13 09:05:24','2026-10-13 09:05:24'),(67,17,1,'观察事实','批次 12121D0032 自 08:20 起 min_wall_thickness 呈单调下漂：4.320→4.290→4.260→4.270 mm，前3点构成 R5 触发条件，第4点（触发点）小幅回升 0.010 mm，尚未确认下漂停止。','批次检验序列 4 条记录（S-001~S-004）壁厚值为 4.320/4.290/4.260/4.270 mm，对应外径 25.230/25.240/25.250/25.260 mm；QMS 备注依次为“基线点/壁厚呈下降趋势/壁厚趋近下限/连续3点趋近下限，未越限”。','S-004 之后的检验点数据；同批次更早（08:20 之前）的基线序列；是否存在未被采样的中间波动。','调取 12121D0032 批次 10:15 之后的全部检验记录，确认壁厚是持续下漂、平台化还是已回升；同时补充该批次开机后前若干点的历史值以判断正常波动带。',0.8000,'[\"IR-20261010-001\", \"IR-20261010-002\", \"IR-20261010-003\", \"IR-20261010-004\", \"QE-20261010-004WT\", \"metric_definition:min_wall_thickness\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-14 01:21:44','2026-10-14 01:21:44'),(68,17,2,'观察事实','触发点壁厚下降并非由外径减小（牵伸相关）引起：外径同步由 25.230 mm 微增至 25.260 mm，仍处规格 25.000~25.500 mm 区间中部附近，说明最薄点减薄与外径变化方向不一致。','S-001~S-004 外径 25.230/25.240/25.250/25.260 mm（下限 25.000、上限 25.500），min_outer 25.120、max_outer 25.360；椭圆度 0.190→0.240 mm，上限 0.350 mm。','无法确认牵引速度、挤出量、线速比的同期设定值；缺少壁厚分布（周向多点）数据。','调取该时段工艺参数趋势（挤出量、牵引速度、真空定型水位等）并与外径-壁厚对应关系比对；增加周向测厚点位以区分整体减薄与局部偏心引起的 min 值下降。',0.5000,'[\"IR-20261010-001\", \"IR-20261010-002\", \"IR-20261010-003\", \"IR-20261010-004\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-14 01:21:44','2026-10-14 01:21:44'),(69,17,3,'待验证假设','与同规格其它批次（12121D0033/12121D0034，壁厚 4.340~4.390 mm）相比，本批次整体壁厚水平偏低约 0.08~0.10 mm，可能属于本批次自身的工艺设定偏移，而非设备突发故障。','参考批次记录壁厚集中在 4.340~4.390 mm 且 quality_flag 均为 normal、椭圆度 0.210~0.230 mm；本批次为 4.260~4.320 mm。参照对比仅为不同批次差异，不等同正式控制限。','参考批次与本批次的工艺设定参数是否一致；同机台更早历史批次的壁厚中心值；换班/换料记录。','核对 12121D0032 与相邻批次的配方、挤出机各区温度、牵引/挤出设定与原料批号，判断差异来自设定还是过程漂移。',0.4500,'[\"IR-20261011-001\", \"IR-20261011-003\", \"IR-20261012-001\", \"IR-20261012-004\", \"IR-20261012-008\", \"IR-20261010-004\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-14 01:21:44','2026-10-14 01:21:44'),(70,17,4,'缺失证据','设备同期数据缺失，无法判断模具偏心、真空定型、水温或牵引稳定性的变化是否与壁厚下漂相关（不得据此推断因果）。','对异常时刻前后 240 分钟与 1440 分钟两次调用设备数据窗口，均返回空结果；预警上下文亦未提供任何设备状态字段。','该时段挤出机/牵引/定型工位的运行参数与报警、停机或参数调整记录。','由工程师从 MES/SCADA 导出 2026-10-10 06:00~12:00 的设备运行参数与操作日志（参数调整、报警、清洗/换网），再与壁厚序列时间对齐分析。',0.9000,'[\"equipment_window:240min\", \"equipment_window:1440min\", \"QE-20261010-004WT\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-14 01:21:44','2026-10-14 01:21:44'),(71,17,5,'判定口径','本次为“接近下限”预警而非超差：按产品规格限值，壁厚合格区间为 4.200~4.800 mm，触发点 4.270 mm 仍高于下限 0.070 mm，距下限 ≤0.090 mm（区间宽度 15%）的接近带仅为预警口径。','指标定义给出 lower_limit 4.200 mm、upper_limit 4.800 mm，limit_source 为产品规格（ppr_product_spec）标准限值；预警上下文 threshold_text 描述接近带为距下限 ≤0.090 mm。','未见该指标的重复性/再现性（测量系统）数据，无法评估 0.01 mm 级的下降是否超出测量噪声。','确认在线/离线测厚方法（超声或千分尺）及重复性数据；对 S-003/S-004 留样复测以验证 4.260→4.270 mm 的差异是否为真实变化。',0.7500,'[\"metric_definition:min_wall_thickness\", \"QE-20261010-004WT\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-14 01:21:44','2026-10-14 01:21:44'),(72,18,1,'触发规则与限值对照','超出标准区间：当前观测值 0.4300 mm，0.000 mm–0.350 mm，实测 0.430 mm，高于上限 0.080 mm。','支持证据：记录 IR-20261011-002 / 样管 S-102 / Sun Oct 11 2026 17:00:00 GMT+0800 (China Standard Time)，来源 QMS；反向或不支持证据：规则模式未复核量具、原始记录和测量方法。','正式标准条款、量具状态、原始检验单与测量方法仍需现场确认。','预期伴随信号：复测结果与原始记录在同一测量条件下可重复；验证动作：复核样管身份、原始测量值、适用规格和测量方法，演示限值不直接等同合格判定。',0.9500,'[\"IR-20261011-002\", \"QE-20261011-006OV\"]',NULL,0,'pending',NULL,NULL,NULL,'2026-10-14 02:08:29','2026-10-14 02:08:29'),(73,18,2,'变化趋势观察','最近 2 个同批次可比较点由 0.220 变化至 0.430 mm，净变化 +0.210 mm。','支持证据：Sun Oct 11 2026 16:00:00 GMT+0800 (China Standard Time): 0.220 mm；Sun Oct 11 2026 17:00:00 GMT+0800 (China Standard Time): 0.430 mm；反向或不支持证据：当前只读取异常时刻及之前最多 5 点，无法核对异常后的恢复情况。','停机、换规格、生产连续性和检测延迟信息未完全确认。','预期伴随信号：若为真实过程趋势，相邻样管应出现方向一致且可重复的变化；验证动作：补齐异常前后连续抽检点并核对运行日志，区分连续趋势与离散波动。',0.4500,'[\"IR-20261011-002\", \"IR-20261011-001\"]',NULL,0,'pending',NULL,NULL,NULL,'2026-10-14 02:08:29','2026-10-14 02:08:29'),(74,18,3,'设备时序待对齐','同批次中按检验时刻距离关联到 4 条设备采集数据，可核查温度、压力与牵引速度是否存在相符变化，但不能称为该样管对应参数。','支持证据：Sun Oct 11 2026 17:00:00 GMT+0800 (China Standard Time) 1号挤出机: 温度205.55℃ / 压力12.377MPa / 牵引-m/min；Sun Oct 11 2026 17:00:00 GMT+0800 (China Standard Time) 1号牵引机: 温度-℃ / 压力-MPa / 牵引8.302m/min；Sun Oct 11 2026 18:00:00 GMT+0800 (China Standard Time) 1号挤出机: 温度205.68℃ / 压力12.272MPa / 牵引-m/min；Sun Oct 11 2026 16:00:00 GMT+0800 (China Standard Time) 1号挤出机: 温度205.41℃ / 压力12.475MPa / 牵引-m/min；反向或不支持证据：尚未用生产时间、长度码、设备距离和检测延迟完成样管对齐。','样管生产时间或长度码、设备至检测点距离、检测延迟、设备设定值、调机记录、报警和运行状态尚未接入。','预期伴随信号：若设备变化与尺寸异常相关，完成物料追踪后应在对应管段重复出现方向一致的尺寸响应；验证动作：先完成时序对齐，再由设备工程师核对设定值、反馈值、调机与报警记录。',0.5500,'[\"ER-20261014015751-YAX9\", \"ER-20261014013110-05QB\", \"ER-20261014015751-8VX9\", \"ER-20261014015751-CHL6\"]',NULL,0,'pending',NULL,NULL,NULL,'2026-10-14 02:08:29','2026-10-14 02:08:29'),(75,19,1,'测量/数据有效性','0.430 mm 的不圆度可能部分或全部来自测量口径、截面位置或测量条件差异，而非管材本身在该时刻真实椭圆化。机理：不圆度定义为同一样管同一截面最大外径减最小外径，仅在截面、量具、测量温度、调节（冷却/时效）时间一致时可比；当前样管外径极差恰等于报出值 0.430 mm，数值自洽，但无法排除测量位置或方法与历史不同。','支持证据：IR-20261011-002 的 max_outer 25.550 与 min_outer 25.120 之差恰为 0.430 mm，与 ovality_mm 自洽；指标定义明确不圆度需“同一样管同一截面”测量；异常记录备注为“不圆度超过演示上限”，提示限值可能为演示口径。反向或不支持证据：现有工具未提供复测、平行样或量具/测量温度/调节时间记录，也无证据表明本次测量方法发生了改变。','量具编号与分辨率、测量温度与样管调节时间、所测截面位置（距端部长度）、取样方向与是否为复测/合样、该限值的审批状态（是否正式规格限值）。','预期伴随信号：若为测量问题，同一样管在规范截面复测或另一截面测量的不圆度应回到 0.220 mm 量级，且与其他样管一致。验证动作：由检验人员按受控规程对留样 S-102 在多个截面与多点复测，记录量具、测量温度与调节时间；同时核对 0.350 mm 上限的批准来源，确认前暂按“数据疑点”处理。',0.5000,'[\"IR-20261011-002\", \"ovality\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-14 02:11:12','2026-10-14 02:11:12'),(76,19,2,'异常形态与三层对照','本次异常是局部截面圆度阶跃（代表性外径与壁厚基本未变的孤立椭圆点），而非整体外径漂移或供料—牵伸变化导致的尺寸偏移。机理：供料量/线速度变化会同时改变代表性外径与壁厚，而周向不均匀机制主要改变同一截面的最大—最小外径差。','支持证据：IR-20261011-002 代表性外径 25.230 mm、壁厚 4.330–4.450 mm，与 IR-20261011-001（25.220 mm、4.340–4.460 mm、不圆度 0.220 mm）几乎一致；同批次前序与同规格正常参考（IR-20261012-001 至 IR-20261012-008，0.210–0.220 mm；IR-20261010-001，0.190 mm）均稳定在 0.19–0.22 mm，仅 IR-20261011-002 达 0.430 mm。反向或不支持证据：同批次仅有 2026-10-11 08:00 与 09:00 两条记录，采样频率无法判断是孤立单点还是已持续；没有 06:00 或更早记录，无法确认是阶跃还是趋势中的一点。','09:00 之后的同批次后续记录、当日更早记录、本批次是否有多点/多截面取样计划、异常样管是否为连续生产中随机抽取。','预期伴随信号：若为局部椭圆单点，后续同批次记录不圆度将回落至 0.19–0.22 mm 且外径/壁厚平稳；若持续高位，则提示稳定的周向不均机制。验证动作：调取该批次后续及当日前段检验记录并排比对，必要时增加取样截面数量以判别单点性与持续性。',0.5500,'[\"IR-20261011-002\", \"IR-20261011-001\", \"IR-20261012-001\", \"IR-20261012-008\", \"IR-20261010-001\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-14 02:11:12','2026-10-14 02:11:12'),(77,19,3,'设备/生产机理（定径与冷却）','该截面椭圆化可能由真空定径接触不均或周向冷却不均引起，使管坯在冷却冻结阶段局部塌陷或缩径。机理：口模出口管坯在定径套内靠真空吸附与冷却定型，周向真空度/水膜/喷淋分布不均会造成局部半径损失，直接表现为最大与最小外径差增大，而代表性外径变化很小。','支持证据：不圆度异常但代表性外径（25.230 mm）与壁厚（4.330–4.450 mm）均在规格内且与前一时刻一致，符合“周向不均匀机制优先于总量机制”的判读规则；同规格其他批次稳定在 0.19–0.22 mm，说明该产线通常具备稳定的定径能力。反向或不支持证据：现有工具未提供真空度、定径套状态、冷却水温/流量、喷淋布置与线速度记录，无任何直接指向定径或冷却变化的现场证据；SCADA 返回的记录仅含挤出机温度/压力与牵引速度，且为检查时刻附近的设备记录，未完成生产时间对齐。','真空定径箱真空度设定与反馈、冷却水温与流量分布、定径套/口模磨损与清理记录、定径套与口模编号及是否更换、喷淋/水膜状态、该样管对应的线速度与生产时间（长度码）。','预期伴随信号：若为定径/冷却不均，同机台同规格其他样管的椭圆长轴方向应相对稳定，且不圆度与真空或冷却参数波动在时间上同步。验证动作：在受控条件下记录并比对定径真空与冷却水参数趋势，检查定径套/口模表面与喷淋状态；对不同周向位置取样测量，观察椭圆长轴方位是否固定，以区分定径/冷却不均与随机测量误差。',0.3500,'[\"IR-20261011-002\", \"IR-20261011-001\", \"IR-20261012-005\", \"ER-20261014015751-YAX9\", \"ER-20261014013110-05QB\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-14 02:11:12','2026-10-14 02:11:12'),(78,19,4,'设备/生产机理（壁厚偏心与同心度）','该异常可能来自壁厚周向偏心（机头芯模同心度、熔体周向分配或牵引偏载），即管壁一侧偏厚一侧偏薄导致同一截面外径差增大。机理：芯模偏心或周向流道阻力差异会形成偏心壁厚，此类偏心在真空/冷却约束不足时同时转化为不圆度，而周向平均外径与平均壁厚变化有限。','支持证据：当前有最小与最大壁厚（4.330/4.450 mm，差 0.12 mm）与最大/最小外径并存，具备产生周向差异的结构条件；不圆度异常而代表性外径基本未变，与该机制方向一致。反向或不支持证据：工具仅返回最小与最大壁厚，不是周向平均壁厚或点位分布，无法识别壁厚在哪个方位偏厚/偏薄，也无法判断壁厚差是否异常于同规格正常水平；同规格正常批次是否也有相近的 0.12 mm 壁厚差未提供，因而不能确认偏心是本次特有。','周向多点壁厚测量值及方位、芯模/口模同心度检查记录、机头拆卸与清理记录、该截面的壁厚偏心与外径之间的对应关系。','预期伴随信号：若为偏心，最小壁厚点方位应与最小外径点方位大致对应，且椭圆长轴/短轴方向在连续取样中重复出现。验证动作：对留样或后续样管按四方位（或八方位）测壁厚与对应外径并绘制偏心方位图；同时核查芯模同心度与机头装配记录，以与定径/冷却不均假设区分。',0.3000,'[\"IR-20261011-002\", \"IR-20261011-001\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-14 02:11:12','2026-10-14 02:11:12'),(79,19,5,'设备/生产机理（牵引/挤出与时间对齐）','牵引速度与挤出机温度/压力在检验时刻附近有轻微变化，但现有证据不足以将其认定为该样管不圆度的原因，需先完成生产时间对齐后再评估供料—牵伸路径。机理：牵引与挤出量的相对变化主要影响代表性外径与壁厚（纵向/总量方向），对同一截面最大与最小外径差影响相对间接；温度变化会同时改变黏度、口模膨胀、熔体强度与冷却负荷。','支持证据：设备窗口返回 2026-10-11 08:00–13:00 的挤出机温度 205.41→206.29 ℃、压力 12.475→12.163 MPa 与牵引速度 8.312→8.529 m/min 的缓慢单调变化。反向或不支持证据：上述为“同批次且接近检验时刻的设备记录”，无长度码、设备到检测点距离与检测延迟，不能称为该样管对应参数；且同一时段外径与壁厚重现性良好（25.220–25.240 mm，壁厚差仅约 0.01–0.03 mm），未显示与该漂移同步的尺寸响应，因此不支持“单一参数直接导致不圆度”的结论。','样管对应的生产时间或长度码、生产线速度与检测点距离（用于换算检测延迟）、挤出机各温区设定与反馈、熔体温度实测、螺杆转速与质量挤出量/米重、牵引机张力或压紧状态记录。','预期伴随信号：若牵引/挤出确实参与，应在完成时间对齐后看到不圆度异常段与牵引速度或温度/压力变化在时间上同步，并伴随外径或壁厚同向变化。验证动作：用长度码或生产时间把样管与设备记录对齐，检查异常前后各参数的同步性；若无法对齐，则将该路径标注为“未验证”，不纳入优先排查。',0.2000,'[\"ER-20261014015751-CHL6\", \"ER-20261014015751-YAX9\", \"ER-20261014015751-OM59\", \"ER-20261014013110-L0M6\", \"ER-20261014013110-05QB\", \"ER-20261014013110-HE13\", \"IR-20261011-002\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-14 02:11:12','2026-10-14 02:11:12'),(80,19,6,'材料机理（暂不能归因）','当前证据不足以支持或排除材料内因（批次/配方稳定性、降解、组分或填料差异、结晶与后收缩差异）对不圆度的贡献，暂不作为优先验证路径。机理：MFR/分子量变化、热氧降解、填料或母料差异会改变熔体弹性与结晶收缩，可能在高分子取向或冷却不均条件下放大截面椭圆化；但材料因素通常同时影响多根样管与多个批次，难以解释单点异常。','支持证据：无任何材料检测、原料批次、配方或换料记录返回，材料路径完全没有当前事件证据可核对。反向或不支持证据：同规格其他正常批次（IR-20261012-001 至 IR-20261012-008）与前一时刻样管不圆度稳定在 0.19–0.22 mm，未见跨批次系统性偏移，该模式不支持材料整体性变化；但当前仅一个异常点，样本量不足以排除。','本批次与相邻批次的原料牌号/批次与换料时间、MFR 或流变数据、DSC 熔融结晶数据、密度/灰分/TGA 组分数据、FTIR 污染或氧化线索、OIT/稳定性数据、在线与离线尺寸成对数据。','预期伴随信号：若为材料因素，异常应跨多根样管与多个检验时刻出现，并伴随 MFR、DSC 或组分检测的可比对差异。验证动作：先完成测量复核与周向壁厚点位检查；仅当异常持续或跨批次复现、且外因无法解释时，按假设选择性送检 MFR/DSC（必要时密度/灰分/FTIR），不作无差别全项检测。',0.1500,'[\"IR-20261011-002\", \"IR-20261012-003\", \"IR-20261012-008\", \"IR-20261011-001\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-14 02:11:12','2026-10-14 02:11:12'),(81,20,1,'测量与数据有效性','本轮 min_wall_thickness 接近下限可能是测量口径或截面可比性问题（最薄点位置、测量温度、调节时间或测量截面变动）导致，而非制品壁厚真实整体下移。','支持证据：指标定义明确“仅最薄点不能代表整体壁厚分布”（IR-20261010-00x 序列为 QMS 来源，record_no IR-20261010-001~004，quality_flag 由 normal 转 medium）。反向或不支持证据：四点 min/max 壁厚同步小幅下移（4.430/4.410/4.390/4.420 与 4.320/4.290/4.260/4.270），外径与不圆度基本稳定，趋势一致性更支持真实变化而非单点测量跳变；但现有工具未提供量具、测量温度、调节时间与截面位置记录，也无周向壁厚点位。','量具型号与校准状态、测量环境温度、样管调节时间、测量截面位置/周向点位编号、同一截面重复测量数据、在线测径与离线检验配对记录。','预期伴随信号：若为测量口径问题，同一截面重复测量离散度大或更换截面后 min 壁厚回到 4.30 mm 以上且 max/min 差值不随之外移；验证动作：按受控检验规程对留样同一截面重复测量并记录周向点位与量具状态，与 S-001 基线点做同方法比对。',0.3500,'[\"IR-20261010-001\", \"IR-20261010-002\", \"IR-20261010-003\", \"IR-20261010-004\"]','deepseek-v4-flash',1,'confirmed',NULL,'123455','质量工程师','2026-10-14 02:16:23','2026-10-14 02:16:38'),(82,20,2,'异常形态与三层对照','该事件属“最小壁厚贴近下限、最大壁厚同步略降、外径与不圆度稳定”的渐变形态，而非外径越界或局部不圆驱动，其机制更可能来自整体壁厚/物料量—牵伸平衡的缓慢偏移。','支持证据：批次序列 min 4.320→4.290→4.260→4.270 mm，max 4.430→4.410→4.390→4.420 mm，外径 25.230→25.260 mm 稳定于 25.000–25.500 mm 中上部，不圆度 0.190→0.240 mm 远低于上限 0.350 mm；四条记录时间约 08:20–10:15，为缓慢渐变而非阶跃或周期。同规格正常参考（批次 12121D0033、12121D0034，record_no IR-20261011-001/003、IR-20261012-001~008）min 壁厚 4.340–4.390 mm、max 4.460–4.510 mm、外径 25.210–25.240 mm、不圆度 0.210–0.230 mm，显示同规格较好状态整体壁厚比当前高约 0.07–0.12 mm。反向或不支持证据：规格下限 4.200 mm 未被突破，最大壁厚仍距上限 4.800 mm 很远，不圆度与最大/最小外径差值（0.23–0.24 mm）未见恶化。','参考批次是否同产线、同口模/定径套、同层结构、同配方与相近速度的确认信息；当前批次更早（08:20 之前）的历史基线；完整壁厚分布（周向点位）与米重数据。','预期伴随信号：若为整体壁厚偏移，周向各点位壁厚应同步下移且米重/质量挤出量同比略降；验证动作：调取本批次开机以来的同方法检验序列与米重记录，并核实参考批次生产线、口模/定径套、层结构、配方与速度一致性，确认后方可作为弱参考。',0.5000,'[\"IR-20261010-001\", \"IR-20261010-002\", \"IR-20261010-003\", \"IR-20261010-004\", \"IR-20261011-001\", \"IR-20261011-003\", \"IR-20261012-003\", \"IR-20261012-008\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-14 02:16:23','2026-10-14 02:16:23'),(83,20,3,'设备/生产机理（时间对齐前提）','在样品与设备记录完成时间对齐前，不能把 2026-10-10 09:00–10:00 的挤出温度缓升（205.00→206.29 ℃）、机头压力缓降（12.550→12.163 MPa）与牵引速度缓升（8.277→8.529 m/min）认定为该样管壁厚下移的原因；它们只能作为同批次且接近检验时刻的相关线索，提示“熔体黏度/供料—牵伸平衡随时间缓慢变化”这一待验证路径。','支持证据：设备窗口记录（ER-20261014015751-GS9C/XV0O/OY8T/IUJ1/AHRZ/CDAJ/A1WB/JBCK 与对应牵引 ER-20261014015751-IVRC/QAG0/9F80/FDVX/DPWU/20HJ/YQYV/RPJI）显示温度 205.00→206.29 ℃ 单调缓升、压力 12.550→12.163 MPa 单调缓降、牵引 8.277→8.529 m/min 单调上升，方向与壁厚缓降一致，且压力下降与牵引上升/温度上升（黏度下降、流动阻力减小）内部自洽。反向或不支持证据：缺少长度码、设备到检测点距离、线速度与检测延迟记录，无法证明设备时间戳对应所检样管；温度字段为设备温度而非实测熔体温度；牵引上升幅度约 3%，而壁厚变化约 1.2–1.4%，方向虽同向但幅度关系未经质量守恒核算；现有工具未提供真空、冷却、螺杆转速与米重数据。','样管长度码/生产时间戳、设备到检验点距离与输送速度、在线测径时间戳、真空定径度、冷却水温/流量、螺杆转速、米重或质量挤出量、温区含义与设定/反馈值、熔体温度实测值。','预期伴随信号：若机理成立，时间对齐后应看到相同时间窗内米重/质量挤出量与牵引速度的比值变化，或壁厚下移与压力/温度变化在时间轴上同步；验证动作：用长度码或在线测径记录把样管与设备记录对齐，同时调取米重与螺杆转速，做质量守恒交叉核对。',0.3000,'[\"IR-20261010-003\", \"IR-20261010-004\", \"ER-20261014015751-GS9C\", \"ER-20261014015751-OY8T\", \"ER-20261014015751-IUJ1\", \"ER-20261014015751-IVRC\", \"ER-20261014015751-QAG0\", \"ER-20261014015751-9F80\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-14 02:16:23','2026-10-14 02:16:23'),(84,20,4,'设备/生产机理（定径—冷却—牵伸链）','壁厚整体缓降而外径稳定，可能与真空定径/冷却冻结状态或定径套与口模的匹配变化有关（离模膨胀—定径接触—牵伸分配改变），表现为尺寸向壁厚优先、外径受限径约束保持；此为待验证假设，非已确认原因。','支持证据：外径在 25.230–25.260 mm 内稳定且不圆度 0.190–0.240 mm 远低于 0.350 mm 上限，说明定径接触与圆周冷却未出现明显恶化信号；壁厚（min 与 max）同步小幅下移，符合“外径受定径约束而壁厚随供料/牵伸变化”的表现形式。反向或不支持证据：现有工具未返回真空度、冷却水温/流量、定径套尺寸、口模间隙或熔体温度数据，无法核实定径区状态变化；不圆度稳定也可解释为定径与冷却状态相对稳定，从而削弱“定径恶化”方向。','真空定径设定与实际真空度、冷却水温与流量、定径套内径与磨损状态、口模/芯模间隙与同心度记录、熔体温度、米重。','预期伴随信号：若定径/冷却侧变化成立，应看到真空度或冷却参数在相近时间窗内的漂移，且外径—壁厚关系偏离既有配比；验证动作：调取同期真空与冷却参数记录、核对定径套与口模状态点检记录，不改变工艺条件下先做数据确认。',0.2500,'[\"IR-20261010-002\", \"IR-20261010-003\", \"IR-20261010-004\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-14 02:16:23','2026-10-14 02:16:23'),(85,20,5,'材料机理','存在待验证的材料内因路径：原料批次/牌号切换、MFR 或分子量分布变化、热氧降解或母料/填料差异导致熔体黏度与结晶收缩行为改变，从而在挤出与牵引条件相近时改变壁厚形成。','支持证据：壁厚呈同向缓慢渐变（min 四点 4.320→4.270 mm），同规格正常参考批次整体壁厚偏高约 0.07–0.12 mm，符合配方或物料状态差异可能带来的稳定偏移形态；PPR 瓷芯管为多层结构，层比与各层流变匹配改变也可同时影响壁厚。反向或不支持证据：现有工具未返回原料批次、换料记录、MFR/DSC/密度/灰分或 FTIR 检测数据，也没有污染或牌号切换线索；设备侧温度/压力/牵引缓变尚可部分解释壁厚变化，因此材料内因目前无独立证据支撑，不应优先归因。','本批次与参考批次的原料牌号与批次号、换料/清机记录、MFR 与 DSC 检测、密度与灰分/TGA、层结构比例与母料信息。','预期伴随信号：若材料内因成立，应看到换料时间点与壁厚偏移起点吻合，或 MFR/DSC 结果与历史批次存在可测差异，且在外因参数恢复后壁厚仍不回位；验证动作：先核对物料批次与换料记录，仅在出现换料线索或外因无法解释时，按假设选择 MFR 或 DSC 送检，不一次性要求全部检测。',0.1500,'[\"IR-20261010-001\", \"IR-20261010-004\", \"IR-20261012-008\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-14 02:16:23','2026-10-14 02:16:23'),(86,20,6,'暂不能归因（证据缺口）','在缺少壁厚周向分布、米重/质量挤出量、真空与冷却记录、以及样品—设备时间对齐的情况下，无法区分“供料/牵伸平衡缓变”“定径冷却状态变化”“材料黏度变化”三条竞争路径，也无法判断是否存在偏心（最小壁厚下降而最大壁厚不同步）。','支持证据：现有工具仅返回四条本批次检验记录与 08:00–15:00 的挤出温度/压力/牵引记录，未返回米重、质量挤出量、螺杆转速、真空、冷却、周向壁厚点位或在线/离线配对数据；min 与 max 壁厚变化幅度接近（约 0.05 mm 与 0.01–0.03 mm），不足以支持或排除偏心机制。反向或不支持证据：不圆度与外径稳定，不支持“显著偏心导致局部最薄点恶化”的强表述，但工具未提供周向点位，故也不能排除。','周向壁厚点位分布与偏心量、米重或质量挤出量、在线测径序列、真空定径与冷却参数、螺杆转速与供料稳定性记录、多批次可比性确认（产线/口模/定径套/配方/速度/测量方法）。','预期伴随信号：若为偏心，周向点位应出现一边薄一边厚且不圆度或最小/最大壁厚差扩大；若为供料—牵伸问题，米重与牵引比值应同向变化；验证动作：在受控检验下补测同一截面周向壁厚点位并调取米重与在线测径记录，按结果分别进入对应验证分支。',0.2000,'[\"IR-20261010-002\", \"IR-20261010-003\", \"IR-20261010-004\", \"ER-20261014015751-OY8T\", \"ER-20261014015751-9F80\"]','deepseek-v4-flash',0,'pending',NULL,NULL,NULL,'2026-10-14 02:16:23','2026-10-14 02:16:23');
/*!40000 ALTER TABLE `ppr_analysis_conclusion` ENABLE KEYS */;
UNLOCK TABLES;

--
-- Table structure for table `ppr_analysis_run`
--

DROP TABLE IF EXISTS `ppr_analysis_run`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `ppr_analysis_run` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT '主键，自增编号',
  `run_no` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '分析任务编号，全局唯一',
  `alert_id` bigint unsigned NOT NULL COMMENT '关联预警事件ID',
  `status` enum('generated','reviewing','completed') COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'generated' COMMENT '分析状态：已生成、复核中、已完成',
  `summary` text COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '分析摘要',
  `evidence_snapshot` json DEFAULT NULL COMMENT '生成时使用的产品、设备、限值和趋势证据快照',
  `engine_type` enum('rule','agent') COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'rule' COMMENT '分析引擎：规则引擎或LangChain Agent',
  `model_name` varchar(100) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Agent模式实际使用的模型名称',
  `prompt_version` varchar(64) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '规则模板或Agent提示词版本',
  `agent_version` varchar(64) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Agent编排实现版本',
  `tool_trace_json` json DEFAULT NULL COMMENT 'Agent工具调用轨迹及返回证据',
  `token_usage_json` json DEFAULT NULL COMMENT '模型Token使用统计',
  `raw_response_json` json DEFAULT NULL COMMENT '模型原始消息的可审计快照',
  `latency_ms` int unsigned DEFAULT NULL COMMENT '本次分析总耗时，单位毫秒',
  `fallback_reason` text COLLATE utf8mb4_unicode_ci COMMENT 'Agent降级到规则引擎的原因',
  `generated_by` varchar(100) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '分析发起人名称或账号',
  `generated_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '分析生成时间',
  `updated_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_ppr_analysis_run_no` (`run_no`),
  KEY `idx_ppr_analysis_alert` (`alert_id`),
  CONSTRAINT `fk_ppr_analysis_alert` FOREIGN KEY (`alert_id`) REFERENCES `ppr_alert_event` (`id`) ON DELETE CASCADE
) ENGINE=InnoDB AUTO_INCREMENT=21 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='PPR异常诊断分析任务';
/*!40101 SET character_set_client = @saved_cs_client */;

--
-- Dumping data for table `ppr_analysis_run`
--

