INSERT INTO `ppr_eight_d_report` VALUES (1,'8D-20261013014026-GS97',1,'QE-20261010-001 过程质量异常8D报告','质量工程师（主责）、生产领班、设备工程师、检验员。具体成员与职责待确认。','PPR S2.5 25×4.2 瓷芯管 / 批次 12121D0032 触发“待复核趋势”。连续3个可比较点下降，规则参数待现场验证','隔离异常时段相关产品并加密复检；核对原始检验记录与设备运行记录；隔离范围由质量工程师最终核定。','【触发规则与限值对照】待复核趋势：当前观测值 4.2600 mm，连续3个可比较点下降，规则参数待现场验证。\n验证发现：现场复核记录完整，确认作为报告输入\n\n【变化趋势观察】最近 3 个同批次可比较点由 4.320 变化至 4.260 mm，净变化 -0.060 mm。\n验证发现：现场复核记录完整，确认作为报告输入\n\n【同期设备因素】同批次同期关联到 3 条设备采集数据，可优先核查温度、压力与牵引速度是否在异常前后发生变化。\n验证发现：现场复核记录完整，确认作为报告输入','确认复测、参数核对和异常批次处置方案。','措施已实施并完成连续三批验证。','更新检验频次、预警规则和设备点检标准。','完成结案复盘并确认团队贡献。','finalized','E2E测试','2026-10-13 01:40:26','2026-10-13 01:40:26','2026-10-13 01:40:26'),(4,'8D-20261014012159-CI2R',17,'QE-20261010-004WT 过程质量异常8D报告','质量工程师（主责）、生产领班、设备工程师、检验员。具体成员与职责待确认。','PPR S2.5 25×4.2 瓷芯管 / 批次 12121D0032 触发“连续3点接近区间边界”。4.200 mm–4.800 mm，连续 3 点进入接近带（距下限 ≤ 0.090 mm，为区间宽度的 15%）：4.290 / 4.260 / 4.270','隔离异常时段相关产品并加密复检；核对原始检验记录与设备运行记录；隔离范围由质量工程师最终核定。','尚无工程师确认的诊断结论，请返回诊断页完成验证。',NULL,NULL,NULL,NULL,'draft','质量工程师',NULL,'2026-10-14 01:21:59','2026-10-14 01:21:59'),(5,'8D-20261014021650-OC4X',20,'QE-20261010-004WT 过程质量异常8D报告','质量工程师（主责）、生产领班、设备工程师、检验员。具体成员与职责待确认。','PPR S2.5 25×4.2 瓷芯管 / 批次 12121D0032 触发“连续3点接近区间边界”。4.200 mm–4.800 mm，连续 3 点进入接近带（距下限 ≤ 0.090 mm，为区间宽度的 15%）：4.290 / 4.260 / 4.270','隔离异常时段相关产品并加密复检；核对原始检验记录与设备运行记录；隔离范围由质量工程师最终核定。','【测量与数据有效性】本轮 min_wall_thickness 接近下限可能是测量口径或截面可比性问题（最薄点位置、测量温度、调节时间或测量截面变动）导致，而非制品壁厚真实整体下移。\n验证发现：123455',NULL,NULL,NULL,NULL,'draft','质量工程师',NULL,'2026-10-14 02:16:50','2026-10-14 02:16:50');
/*!40000 ALTER TABLE `ppr_eight_d_report` ENABLE KEYS */;
UNLOCK TABLES;

