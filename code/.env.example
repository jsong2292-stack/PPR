# ─────────────────────────────────────────────────────────────
# PPR 质量智能分析助手 · 环境变量样例
# 复制为 .env.local（开发）或 .env.production（部署）后填写真实值。
# 真实文件已在 .gitignore 中排除，切勿提交。
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
HOST=0.0.0.0
PORT=3000
APP_URL=http://127.0.0.1:3000

# MySQL 8.0.16+
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ppr_quality
# 应用账号：只有 DML 权限（SELECT/INSERT/UPDATE/DELETE），不能建表改表
DB_USER=ppr_app
DB_PASSWORD=change-me
# 迁移账号：建表/迁移时使用，权限更高
DB_MIGRATION_USER=ppr_migrator
DB_MIGRATION_PASSWORD=change-me
DB_CONNECTION_LIMIT=10
DB_TIMEZONE=+08:00
DB_SSL=false

# 会话与安全
AUTH_SECRET=change-me-to-a-32-byte-random-string
SESSION_TTL_HOURS=12
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me
BOOTSTRAP_ADMIN_NAME=系统管理员

# 后台规则引擎
ENABLE_RULE_SCHEDULER=true
RULE_SCAN_INTERVAL_SECONDS=300
RULE_SCAN_LOOKBACK_HOURS=72

# 通知（未配置 SMTP 时通知只落库）
NOTIFY_TRANSPORT=db
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

MAX_UPLOAD_MB=20
