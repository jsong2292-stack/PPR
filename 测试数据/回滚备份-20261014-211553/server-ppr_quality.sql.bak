--
-- Table structure for table `ppr_alert_event`
--

DROP TABLE IF EXISTS `ppr_alert_event`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `ppr_alert_event` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT '主键，自增编号',
  `event_no` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '预警事件编号，全局唯一',
  `measurement_id` bigint unsigned NOT NULL COMMENT '触发预警的产品检验记录ID',
  `metric_code` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '触发指标编码',
  `risk_level` enum('normal','medium','high','error') COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '风险级别：正常、中风险、高风险、数据错误',
  `rule_code` varchar(32) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '触发规则编码',
  `rule_name` varchar(200) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '触发规则名称',
  `observed_value` decimal(12,4) DEFAULT NULL COMMENT '触发时的观测值',
  `threshold_text` varchar(200) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '触发阈值文本快照',
  `status` enum('open','analyzing','closed') COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'open' COMMENT '事件状态：待分析、分析中、已关闭',
  `source` enum('engine','legacy') COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'engine' COMMENT '事件来源：engine=判定引擎生成，legacy=历史演示或人工遗留',
  `notified_level` enum('medium','high') COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '已推送到企业微信的最高风险级别，NULL=未推送；用于重算时避免重复告警',
  `notified_at` datetime DEFAULT NULL COMMENT '最近一次企业微信推送时间',
  `detected_at` datetime NOT NULL COMMENT '预警识别时间',
  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `updated_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_ppr_alert_event_no` (`event_no`),
  UNIQUE KEY `uk_ppr_alert_measurement_metric_rule` (`measurement_id`,`metric_code`,`rule_code`),
  KEY `idx_ppr_alert_status_time` (`status`,`detected_at`),
  CONSTRAINT `fk_ppr_alert_measurement` FOREIGN KEY (`measurement_id`) REFERENCES `ppr_product_measurement` (`id`) ON DELETE CASCADE
) ENGINE=InnoDB AUTO_INCREMENT=142 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='PPR质量监控预警事件';
/*!40101 SET character_set_client = @saved_cs_client */;

--
-- Dumping data for table `ppr_alert_event`
--

LOCK TABLES `ppr_alert_event` WRITE;
/*!40000 ALTER TABLE `ppr_alert_event` DISABLE KEYS */;
INSERT INTO `ppr_alert_event` VALUES (1,'QE-20261010-001',3,'min_wall_thickness','medium','R4','待复核趋势',4.2600,'演示遗留事件，已被判定引擎的真实判定取代','closed','legacy',NULL,NULL,'2026-10-10 09:38:00','2026-10-13 01:36:53','2026-10-13 07:27:30'),(5,'QE-20261010-001OD',1,'outer_diameter','normal','R0','在标准区间内',25.2300,'25.000 mm–25.500 mm，实测 25.230 mm，未进入接近带','closed','engine',NULL,NULL,'2026-10-10 08:20:00','2026-10-13 07:26:22','2026-10-13 07:26:22'),(6,'QE-20261010-002OD',2,'outer_diameter','normal','R0','在标准区间内',25.2400,'25.000 mm–25.500 mm，实测 25.240 mm，未进入接近带','closed','engine',NULL,NULL,'2026-10-10 09:05:00','2026-10-13 07:26:22','2026-10-13 07:26:22'),(7,'QE-20261010-003OD',3,'outer_diameter','normal','R0','在标准区间内',25.2500,'25.000 mm–25.500 mm，实测 25.250 mm，未进入接近带','closed','engine',NULL,NULL,'2026-10-10 09:37:00','2026-10-13 07:26:22','2026-10-13 07:26:22'),(8,'QE-20261010-004OD',4,'outer_diameter','normal','R0','在标准区间内',25.2600,'25.000 mm–25.500 mm，实测 25.260 mm，未进入接近带','closed','engine',NULL,NULL,'2026-10-10 10:15:00','2026-10-13 07:26:22','2026-10-13 07:26:22'),(9,'QE-20261010-001WT',1,'min_wall_thickness','normal','R0','在标准区间内',4.3200,'4.200 mm–4.800 mm，实测 4.320 mm，未进入接近带','closed','engine',NULL,NULL,'2026-10-10 08:20:00','2026-10-13 07:26:22','2026-10-13 07:26:22'),(10,'QE-20261010-002WT',2,'min_wall_thickness','normal','R0','在标准区间内',4.2900,'4.200 mm–4.800 mm，实测 4.290 mm，已进入接近带但未连续 3 点','closed','engine',NULL,NULL,'2026-10-10 09:05:00','2026-10-13 07:26:22','2026-10-13 07:26:22'),(11,'QE-20261010-003WT',3,'min_wall_thickness','normal','R0','在标准区间内',4.2600,'4.200 mm–4.800 mm，实测 4.260 mm，已进入接近带但未连续 3 点','closed','engine',NULL,NULL,'2026-10-10 09:37:00','2026-10-13 07:26:22','2026-10-13 07:26:22'),(12,'QE-20261010-004WT',4,'min_wall_thickness','medium','R5','连续3点接近区间边界',4.2700,'4.200 mm–4.800 mm，连续 3 点进入接近带（距下限 ≤ 0.090 mm，为区间宽度的 15%）：4.290 / 4.260 / 4.270','analyzing','engine','medium','2026-10-14 01:48:42','2026-10-10 10:15:00','2026-10-13 07:26:22','2026-10-14 02:16:23'),(13