", \"max_outer_diameter_mm\": \"25.320\", \"max_wall_thickness_mm\": \"4.460\", \"min_outer_diameter_mm\": \"25.100\", \"min_wall_thickness_mm\": \"4.340\"}, {\"id\": 6, \"remark\": \"不圆度超过演示上限\", \"batch_id\": 2, \"record_no\": \"IR-20261011-002\", \"sample_no\": \"S-102\", \"created_at\": \"2026-10-13T01:36:53.000Z\", \"ovality_mm\": \"0.430\", \"updated_at\": \"2026-10-13T01:36:53.000Z\", \"data_source\": \"QMS\", \"inspect_time\": \"2026-10-11T09:00:00.000Z\", \"quality_flag\": \"high\", \"outer_diameter_mm\": \"25.230\", \"max_outer_diameter_mm\": \"25.550\", \"max_wall_thickness_mm\": \"4.450\", \"min_outer_diameter_mm\": \"25.120\", \"min_wall_thickness_mm\": \"4.330\"}]}','rule',NULL,'rule-v2.0',NULL,NULL,NULL,NULL,4,NULL,'merge-verify','2026-10-14 02:08:29','2026-10-14 02:08:29'),(19,'AN-20261014021111-1347',24,'generated','事件 QE-20261011-006OV（触发规则 R3“超出标准区间”）来自批次 12121D0033、乙班、样管 S-102、检验记录 IR-20261011-002（检验时刻 2026-10-11 09:00），不圆度 0.430 mm，高于规格上限 0.350 mm 达 0.080 mm。该样管 max_outer 25.550、min_outer 25.120（极差恰为 0.430），而代表性外径 25.230 mm 与同批次前一样管 S-101（25.220 mm，不圆度 0.220 mm）几乎一致，最小/最大壁厚（4.330/4.450 mm）也落在规格内且与前一时刻接近。同规格其他正常批次（12121D0034 甲班 8 个连续记录均为 0.210–0.220 mm；12121D0032 为 0.190 mm）不圆度分布高度一致，说明本次是局部截面圆度突变而非代表性外径漂移。当前优先验证方向为周向冷却/真空定径接触不均、壁厚偏心/芯模同心度、支撑下垂与测量截面方法四类竞争假设，并需先确认测量口径与截面位置；现有工具未提供真空、冷却、米重、线速度对齐、周向壁厚点位、材料检测及限值审批状态，故不得作出最终根因判定或调机决策。','{\"alert\": {\"id\": 24, \"source\": \"engine\", \"status\": \"analyzing\", \"spec_id\": 1, \"batch_id\": 2, \"batch_no\": \"12121D0033\", \"event_no\": \"QE-20261011-006OV\", \"record_no\": \"IR-20261011-002\", \"rule_code\": \"R3\", \"rule_name\": \"超出标准区间\", \"sample_no\": \"S-102\", \"spec_name\": \"PPR S2.5 25×4.2 瓷芯管\", \"created_at\": \"2026-10-13T07:26:22.000Z\", \"ovality_mm\": \"0.430\", \"risk_level\": \"high\", \"updated_at\": \"2026-10-14T02:08:29.000Z\", \"data_source\": \"QMS\", \"detected_at\": \"2026-10-11T09:00:00.000Z\", \"metric_code\": \"ovality\", \"notified_at\": null, \"inspect_time\": \"2026-10