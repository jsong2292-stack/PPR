# ==========================================
# 通用平台脚手架 - 环境变量示例
# ==========================================
# 复制本文件为 .env.local 并填写实际值。
# 注意：.env.local 含敏感信息，已在 .gitignore 中忽略，禁止提交。

# ==================== 应用 ====================
# 服务端口（脚本默认 9010）
PORT=9010

# 运行环境：development / production
NODE_ENV=development

# 对外访问地址（用于拼接回调地址等）
NEXT_PUBLIC_APP_URL=http://localhost:9010

# Session JWT 签名密钥（必填，生产环境请使用 32 位以上随机字符串）
JWT_SECRET=please-change-me-to-a-random-32-chars-string

# Session Cookie 名称与有效期（天），默认 session / 7
SESSION_COOKIE_NAME=session
SESSION_TTL_DAYS=7

# 是否给 Cookie 追加 Secure 标记。
# 默认：生产环境自动开启。本地用生产模式跑 HTTP 调试时设为 false，否则浏览器不保存 Cookie。
# SESSION_COOKIE_SECURE=false

# ==================== 数据库（MySQL） ====================
# MySQL 连接串，优先读取 MYSQL_URL（本地 docker 默认 root / root）
MYSQL_URL=mysql://root:root@127.0.0.1:3306/ppr_quality
# DATABASE_URL=mysql://root:root@127.0.0.1:3306/ppr_quality
# 也可使用分项变量（未配置 MYSQL_URL / DATABASE_URL 时生效）：
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=root
# MYSQL_DATABASE=ppr_quality

# ==================== 文件上传 ====================
# 上传大小上限（MB）；运行时可被 system_config.max_file_size 覆盖
MAX_FILE_SIZE=500

# 存储驱动：auto（默认，检测到完整 MinIO 配置时自动启用）/ local / minio
FILE_STORAGE_DRIVER=auto

# 本地上传根目录的父级路径（默认取进程工作目录，即写入 ./public/uploads）
# UPLOAD_BASE_PATH=/data/app

# MinIO / S3 兼容对象存储
# MINIO_ENDPOINT=http://127.0.0.1:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=please-change-me
# MINIO_BUCKET=platform-demo
MINIO_REGION=us-east-1
MINIO_FORCE_PATH_STYLE=true
# 可选：公开桶或 CDN 的“桶根地址”。未配置时通过 /api/storage/* 动态生成私有桶签名。
# 示例：https://files.example.com/platform-demo
# MINIO_PUBLIC_URL=
# 私有桶临时签名有效期，单位秒，最大 7 天；稳定业务地址不会随签名过期。
MINIO_PRESIGNED_URL_TTL_SECONDS=900

# ==================== 单点登录（OAuth 2.0，可选） ====================
# 未填写 CLIENT_ID / CLIENT_SECRET / REDIRECT_URI 时，SSO 功能自动关闭，
# 前端只展示账号密码登录。
#
# 飞连示例：
#   OAUTH_PROVIDER_NAME=feilian
#   OAUTH_PROVIDER_DISPLAY_NAME=飞连
#   OAUTH_PROVIDER_ICON=🔐
#   OAUTH_AUTH_URL=https://passport.feilian.cn/oauth/authorize
#   OAUTH_TOKEN_URL=https://passport.feilian.cn/oauth/token
#   OAUTH_USER_INFO_URL=https://passport.feilian.cn/oauth/userinfo
#   OAUTH_REDIRECT_URI=https://your-domain.com/api/auth/oauth/callback
#
# 企业微信 / Keycloak / Authing 等只需替换上面四个地址。

OAUTH_PROVIDER_NAME=sso
OAUTH_PROVIDER_DISPLAY_NAME=企业单点登录
OAUTH_PROVIDER_ICON=🔐

OAUTH_AUTH_URL=
OAUTH_TOKEN_URL=
OAUTH_USER_INFO_URL=

OAUTH_SCOPE=openid profile email

OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# 回调地址必须与 OAuth 应用后台登记的地址完全一致
OAUTH_REDIRECT_URI=

# ==================== 站点信息（前端可见） ====================
NEXT_PUBLIC_SITE_NAME=PPR质量智能分析助手
NEXT_PUBLIC_SITE_NAME_EN=QUALITY ANALYSIS COPILOT
NEXT_PUBLIC_SITE_LOGO_TEXT=PPR
NEXT_PUBLIC_SITE_DESCRIPTION=PPR过程质量异常智能分析助手
NEXT_PUBLIC_SITE_COPYRIGHT=© 日丰通用平台
NEXT_PUBLIC_SITE_OWNER=

# ==================== 部署平台（一般无需修改） ====================
# COZE 沙箱环境标识，值为 PROD 时强制校验环境变量
# COZE_PROJECT_ENV=
# COZE_WORKSPACE_PATH=

# ==================== 质量分析 Agent（可选） ====================
# 默认 rule：完全使用本地确定性规则，不调用大模型。
# 设为 agent 后使用 LangChain createAgent；也可在“管理后台 → 系统设置 → 质量 Agent”运行时切换。
QUALITY_ANALYSIS_MODE=rule

# API密钥只放环境变量，不写入数据库。优先 QUALITY_AGENT_API_KEY，兼容 OPENAI_API_KEY。
QUALITY_AGENT_API_KEY=
# OPENAI_API_KEY=

# OpenAI或兼容网关地址；使用官方OpenAI时留空。
QUALITY_AGENT_BASE_URL=
# OPENAI_BASE_URL=

# 模型名可由系统设置覆盖。
QUALITY_AGENT_MODEL=gpt-6-luna
QUALITY_AGENT_REASONING_EFFORT=low
QUALITY_AGENT_MAX_TOOL_ROUNDS=8
QUALITY_AGENT_TIMEOUT_MS=90000
QUALITY_AGENT_FALLBACK_TO_RULE=true
# OpenAI Responses API默认开启；兼容网关仅支持Chat Completions时设为false。
QUALITY_AGENT_USE_RESPONSES_API=true
# DeepSeek等推理模型在工具强制选择时建议关闭thinking，避免tool_choice冲突。
QUALITY_AGENT_THINKING_MODE=disabled

# ==================== 企业微信预警推送（可选） ====================
# 预警判定引擎产出中/高风险事件时，推送告警到企业微信群机器人。
# 推荐在「管理后台 → 系统设置 → 预警推送」里配置（写入 system_config，改完立即生效）；
# 下面的变量是部署级兜底默认值，system_config 有值时以数据库为准。
# 默认关闭：WECOM_ALERT_ENABLED 为 false 或未配置 Webhook 时，不会产生任何外发请求。
WECOM_ALERT_ENABLED=false
# 群机器人 Webhook 地址，形如 https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx
# 含密钥，禁止提交到代码库。
WECOM_ALERT_WEBHOOK=
# 最低推送级别：medium=中风险及以上（默认）、high=仅高风险
WECOM_ALERT_MIN_LEVEL=medium
# 推送时@的成员userid（不是姓名/手机号），多个用逗号分隔
WECOM_ALERT_MENTION_LIST=
# 推送时是否@所有人
WECOM_ALERT_MENTION_ALL=false
