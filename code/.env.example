# ─────────────────────────────────────────────────────────────
# PPR 质量智能分析助手 · 环境变量样例
#
# 用法：
#   本地开发   复制为 .env.local
#   生产部署   复制为 .env.production（或交给 systemd / 容器注入）
# 真实文件已在 .gitignore 中排除，切勿提交到代码仓库。
#
# 标记「必填」的变量没有默认值，缺失时服务会在启动阶段直接报错退出，
# 而不是带着半配置状态运行到线上才发现。
# ─────────────────────────────────────────────────────────────

# ── 运行时 ───────────────────────────────────────────────────
NODE_ENV=production
# 监听地址：容器内用 0.0.0.0，仅本机访问用 127.0.0.1
HOST=0.0.0.0
PORT=3000
# 对外可访问地址，用于日志、通知正文与导出链接
APP_URL=http://127.0.0.1:3000
# 优雅退出等待时间（毫秒）。反向代理的退出超时应大于此值
SHUTDOWN_TIMEOUT_MS=10000

# ── MySQL 8.0.16+ ────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ppr_quality
# 应用账号：只有 DML 权限（SELECT/INSERT/UPDATE/DELETE），不能建表改表（必填）
DB_USER=ppr_app
DB_PASSWORD=change-me
# 迁移账号：执行 db:migrate 时使用，需要 DDL 权限（必填，仅在迁移时需要）
DB_MIGRATION_USER=ppr_migrator
DB_MIGRATION_PASSWORD=change-me
DB_CONNECTION_LIMIT=10
# 现场时区。服务会把它同时用于驱动解析与会话 time_zone，两边不一致会导致时间字段偏移 8 小时
DB_TIMEZONE=+08:00
DB_SSL=false
# 慢查询/长事务观测阈值（毫秒），超过会在日志中告警
DB_SLOW_QUERY_MS=1000

# 启动时是否跳过数据库连通性检查。
# 注意：代码只认字面量 1，写 true/false 都不生效。默认不跳过；
# 仅当数据库晚于应用启动时才临时设为 1。
SKIP_DB_STARTUP_CHECK=0

# ── 会话与安全 ───────────────────────────────────────────────
# 必填：至少 32 字节的随机字符串，例如 openssl rand -base64 48
AUTH_SECRET=change-me-to-a-32-byte-random-string
SESSION_TTL_HOURS=12
SESSION_COOKIE_NAME=ppr_session
# bcrypt 代价因子；现场机器性能足够时建议 12
BCRYPT_ROUNDS=10

# ── 首次部署引导管理员（上线后必须移除）──────────────────────
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me
BOOTSTRAP_ADMIN_NAME=系统管理员

# ── 后台规则引擎 ─────────────────────────────────────────────
# 规则扫描：把新抽检记录按 R1–R5 顺序判定并落预警事件
ENABLE_RULE_SCHEDULER=true
RULE_SCAN_INTERVAL_SECONDS=300
RULE_SCAN_LOOKBACK_HOURS=72
RULE_SCAN_BATCH_SIZE=500

# ── 预警通知 ─────────────────────────────────────────────────
# db   = 只落库，界面里人工外发（默认，适合内网未开邮件网关的场景）
# smtp = 落库并尝试投递
NOTIFY_TRANSPORT=db
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── 上传与日志 ───────────────────────────────────────────────
# Excel 导入文件大小上限（MB）
MAX_UPLOAD_MB=20
# debug | info | warn | error
LOG_LEVEL=info
# 是否记录每个 HTTP 请求（生产环境建议 false，避免日志噪声）
LOG_REQUESTS=false

# ── 工具链检查逃生开关（仅用于 CI 或特殊环境）────────────────
# 设为 1 可跳过 Node / pnpm 版本校验（只认字面量 1；CI 或特殊环境才用）
SKIP_TOOLCHAIN_CHECK=0
