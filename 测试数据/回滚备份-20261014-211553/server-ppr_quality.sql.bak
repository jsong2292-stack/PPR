INSERT INTO `ppr_history_archive` VALUES (1,'AR-20261013014026-X9YV',1,'QE-20261010-001','12121D0032','min_wall_thickness','medium','PPR S2.5 25×4.2 瓷芯管 / 批次 12121D0032 触发“待复核趋势”。连续3个可比较点下降，规则参数待现场验证','待复核趋势：当前观测值 4.2600 mm，连续3个可比较点下降，规则参数待现场验证。；验证：现场复核记录完整，确认作为报告输入\n最近 3 个同批次可比较点由 4.320 变化至 4.260 mm，净变化 -0.060 mm。；验证：现场复核记录完整，确认作为报告输入\n同批次同期关联到 3 条设备采集数据，可优先核查温度、压力与牵引速度是否在异常前后发生变化。；验证：现场复核记录完整，确认作为报告输入','确认复测、参数核对和异常批次处置方案。\n措施已实施并完成连续三批验证。\n更新检验频次、预警规则和设备点检标准。','E2E测试','2026-10-13 01:40:26');
/*!40000 ALTER TABLE `ppr_history_archive` ENABLE KEYS */;
UNLOCK TABLES;

